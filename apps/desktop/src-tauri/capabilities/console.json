{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "console",
  "description": "The management console may inspect displays, acknowledge the usage guide and export/restore data. Rust routes exit replies to the current draft owner.",
  "windows": ["console"],
  "permissions": ["allow-get-monitors", "allow-get-window-status", "allow-get-console-position-status", "allow-get-usage-guide-seen", "allow-acknowledge-usage-guide", "allow-get-pending-exit", "allow-resolve-exit", "allow-export-backup", "allow-preview-restore", "allow-restore-backup", "allow-get-startup-recovery", "allow-recover-startup-backup", "allow-restart-after-recovery"]
}
